#!/bin/sh
set -eu
current=$(id -un)
case "$current" in level[1-9]|level10);;*)echo "Run validate from a level account." >&2;exit 1;;esac
home=/home/$current
[ -d "$home/company" ]||{ echo "The level exercise directory is missing." >&2;exit 1;}
# Match the PolyLinux short-key convention: serialize current state, SHA-256,
# Base64-encode the hash text, and display only the first 20 characters.
state_hash=$(
    find "$home/company" -mindepth 1 -print 2>/dev/null |
    sort |
    while IFS= read -r path
    do
        relative=${path#"$home"/}
        stat -c "$relative|%F|%U|%G|%a|%s" "$path"
    done |
    sha256sum |
    awk '{print $1}'
)
code=$(printf '%s' "$state_hash"|base64|tr -d '\r\n'|cut -c 1-20)
printf 'Validation code: %s\n' "$code"
