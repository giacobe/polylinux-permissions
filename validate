#!/bin/sh
current=$(id -un);case "$current" in level[1-9]|level10);;*)echo 'Run validate from a level account.' >&2;exit 1;;esac
home=/home/$current
[ -f "$home/README.txt" ]||{ echo 'This level is not ready.' >&2;exit 1;}
find "$home/company" -mindepth 1 -print 2>/dev/null|sort|while IFS= read -r path;do relative=${path#"$home"/};stat -c "$relative|%F|%U|%G|%a|%s" "$path";done|sha256sum|awk '{print "Your key is: "$1}'
