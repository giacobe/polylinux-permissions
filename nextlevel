#!/bin/sh
level_prefix=$(printf '%s\n' "$USER" | sed 's/[0-9]//g')
level_number=$(printf '%s\n' "$USER" | sed 's/[^0-9]//g')
[ -n "$level_number" ] || { echo 'Could not determine the current level.'; exit 1; }
[ "$level_number" -lt 10 ] || { echo 'You are already at the final level.'; exit 0; }
su - "$level_prefix$(expr "$level_number" + 1)"
