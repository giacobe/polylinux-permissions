#!/bin/sh
current=$(id -un)
case "$current" in level[1-9])n=$((${current#level}+1));;level10)echo 'You are already at the final level.';exit 0;;*)echo 'Run nextlevel from a level account.' >&2;exit 1;;esac
while [ ! -f "/home/level$n/README.txt" ];do echo "Level $n is not ready yet.";sleep 1;done
exec sudo -u "level$n" -i
